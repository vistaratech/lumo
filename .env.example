# Lumo — Copy to .env and fill values: cp .env.example .env

# Firebase (Console > Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Firebase Auth > Google provider)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REVERSED_CLIENT_ID=

# MQTT Broker (remote access)
EXPO_PUBLIC_MQTT_HOST=broker.emqx.io
EXPO_PUBLIC_MQTT_PORT=8084
EXPO_PUBLIC_MQTT_USER=
EXPO_PUBLIC_MQTT_PASS=
EXPO_PUBLIC_MQTT_BASE=home/esp32
