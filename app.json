{
  "expo": {
    "name": "Lumo",
    "slug": "lumo",
    "scheme": "lumo",
    "version": "2.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vistaratech.lumo",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1087681119264-ul56sv4ue86edpr5vfkqkd4dlsbjl3j1",
              "lumo"
            ]
          }
        ],
        "NSBluetoothAlwaysUsageDescription": "Lumo requires Bluetooth to discover and control your smart home ESP32 relays.",
        "NSBluetoothPeripheralUsageDescription": "Lumo requires Bluetooth to discover and control your smart home ESP32 relays."
      }
    },
    "android": {
      "package": "com.vistaratech.lumo",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B101B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Lumo requires Bluetooth to discover and control your smart home ESP32 relays."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF9F1C"
        }
      ]
    ]
  }
}
