{
  "expo": {
    "name": "Lumo",
    "slug": "lumo",
    "scheme": "lumo",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vistaratech.lumo",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Lumo requires Bluetooth to discover and control your smart home ESP32 relays.",
        "NSBluetoothPeripheralUsageDescription": "Lumo requires Bluetooth to discover and control your smart home ESP32 relays."
      }
    },
    "android": {
      "package": "com.vistaratech.lumo",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B101B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Lumo requires Bluetooth to discover and control your smart home ESP32 relays."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-web-browser"
    ]
  }
}
